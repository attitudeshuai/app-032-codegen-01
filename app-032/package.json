{
  "name": "lantern-frame-lofting",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "花灯骨架放样与蒙面裁片 · Lantern Frame Lofting",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:cut": "esbuild scripts/cut-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/cut-test.mjs && node node_modules/.cache/cut-test.mjs",
    "test:cut-store": "esbuild scripts/cut-store-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/cut-store-test.mjs && node node_modules/.cache/cut-store-test.mjs",
    "test": "npm run test:cut && npm run test:cut-store"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
